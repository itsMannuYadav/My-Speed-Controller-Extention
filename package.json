{
  "name": "speedpilot",
  "private": true,
  "version": "1.0.0",
  "description": "SpeedPilot — universal video speed controller (website + extension monorepo)",
  "workspaces": [
    "shared",
    "website",
    "extension"
  ],
  "scripts": {
    "dev": "npm run dev --workspace website",
    "dev:extension": "npm run dev --workspace extension",
    "build": "npm run build --workspace website",
    "build:extension": "npm run build --workspace extension",
    "build:all": "npm run build --workspace website && npm run build --workspace extension",
    "test": "npm run test --workspace shared",
    "lint:extension": "npm run lint --workspace extension"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "sharp@0.33.5": true,
    "unrs-resolver@1.12.2": true
  }
}
