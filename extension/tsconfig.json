{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["chrome"],
    "paths": {
      "@speedpilot/shared": ["../shared/index.ts"],
      "@speedpilot/shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts"]
}
