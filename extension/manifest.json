{
  "manifest_version": 3,
  "name": "SpeedPilot — Universal Video Speed Controller",
  "short_name": "SpeedPilot",
  "version": "1.0.0",
  "description": "Instantly control playback speed on any HTML5 video or audio, with per-site memory and keyboard shortcuts.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SpeedPilot",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "increase-speed": {
      "suggested_key": { "default": "Ctrl+Shift+D" },
      "description": "Increase playback speed"
    },
    "decrease-speed": {
      "suggested_key": { "default": "Ctrl+Shift+A" },
      "description": "Decrease playback speed"
    },
    "reset-speed": {
      "suggested_key": { "default": "Ctrl+Shift+S" },
      "description": "Reset playback speed to 1x"
    },
    "toggle-controller": {
      "suggested_key": { "default": "Ctrl+Shift+V" },
      "description": "Show or hide the on-video controller"
    }
  },
  "minimum_chrome_version": "116"
}
